# Files and folders excluded from a distributed copy of the plugin.
#
# `npm run plugin-zip` builds its archive from the `files` list in
# `package.json`, so these entries are a second, independent guard: they keep a
# development-only file out of any other packaging path too (wp dist-archive,
# SVN or deploy actions that honour .distignore).

.git
.github
.gitignore
.distignore
